# dependencies
node_modules/

# build output
dist/

# Tauri
src-tauri/target/
# gen/android is TRACKED (Firebase/google-services wiring lives there);
# build outputs + signing secrets are excluded by src-tauri/gen/android/.gitignore
src-tauri/gen/android/keystore.properties
src-tauri/gen/apple/build/
# Tauri copies bundle.resources (tauri.ios.conf.json) here on each iOS build.
src-tauri/gen/apple/assets/
# DeepFilterNet3 weights (39 MB): scripts/fetch-dfn3.sh downloads and
# verifies them. NOTICE and the licence files beside them are committed.
src-tauri/resources/dfn3/dfn3_ll.nnef.tar
src-tauri/resources/dfn3/*.part

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# debug
npm-debug.*

