<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 13+ runtime notification permission; requested by
         K2PushPlugin.requestPermission(), never at install/launch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!-- DORMANT-SAFE: registered here via manifest merge, but FCM only
             ever starts this service once a default FirebaseApp exists —
             i.e. after google-services.json + the gradle plugin land at
             activation (docs/push-activation.md). Until then it is inert. -->
        <service
            android:name="com.alakazamlabs.k2so.push.K2FirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
