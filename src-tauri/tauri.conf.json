{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "K2",
  "version": "4.2.2",
  "identifier": "com.alakazamlabs.k2so.companion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "K2",
        "width": 400,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; worker-src 'self' blob:; img-src 'self' http: https: data: blob:; media-src 'self' http: https: data: blob:; connect-src 'self' ipc: http://ipc.localhost http: https: ws: wss: data: blob:; font-src 'self' data:; frame-src 'none'",
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "minimumSystemVersion": "15.0",
      "infoPlist": "Info.ios.plist",
      "bundleVersion": "202611100309"
    },
    "android": {
      "minSdkVersion": 26
    }
  },
  "plugins": {}
}
