<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App is all dark: force dark appearance (keyboard included) even
	     when the system is in Light mode. Mirrored in gen/apple/project.yml. -->
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
	<!-- Communication Notifications: the app declares the intent its
	     Notification Service Extension (gen/apple/K2NotificationService)
	     donates. Mirrored in gen/apple/project.yml. -->
	<key>NSUserActivityTypes</key>
	<array>
		<string>INSendMessageIntent</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<!-- MUST stay true. tao 0.35.3 only registers the scene delegate
		     when this is true. false = solid black screen on iOS 26 and 27,
		     verified 2026-09-29 (e24b6bc FAIL). iPad second window is an
		     accepted tradeoff; if it becomes a problem, handle the second
		     scene — do not flip this flag. -->
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>TaoSceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
</dict>
</plist>
