<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App is all dark: force dark appearance (keyboard included) even
	     when the system is in Light mode. Mirrored in gen/apple/project.yml. -->
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
	<!-- Communication Notifications: the app declares the intent its
	     Notification Service Extension (gen/apple/K2NotificationService)
	     donates. Mirrored in gen/apple/project.yml. -->
	<key>NSUserActivityTypes</key>
	<array>
		<string>INSendMessageIntent</string>
	</array>
	<!-- Silent `{kind:"badge"}` pushes (content-available) update the
	     app-icon badge in the background (k2-push plugin,
	     K2BadgeStore.swift). Mirrored in gen/apple/project.yml. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<!-- Composer attach menu (AttachMenu.tsx): "Take Photo or Video" opens
	     the camera through a capture file input; recording a video takes
	     sound too. The photo library uses PHPicker (no permission needed).
	     Mirrored in gen/apple/project.yml. -->
	<key>NSCameraUsageDescription</key>
	<string>K2 uses the camera so you can attach a photo or video to a message.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>K2 uses the microphone to record sound when you attach a video to a message.</string>
	<!-- Export compliance: only Apple's HTTPS/TLS (exempt), so App Store
	     Connect does not hold each TestFlight build for the question.
	     Mirrored in gen/apple/project.yml. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<!-- MUST stay true. tao 0.35.3 only registers the scene delegate
		     when this is true. false = solid black screen on iOS 26 and 27,
		     verified 2026-09-29 (e24b6bc FAIL). iPad second window is an
		     accepted tradeoff; if it becomes a problem, handle the second
		     scene — do not flip this flag. -->
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>TaoSceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
</dict>
</plist>
